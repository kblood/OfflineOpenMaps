{
  "name": "@openmaps/core",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./client": { "types": "./dist/client/index.d.ts", "import": "./dist/client/index.js" },
    "./pack": { "types": "./dist/pack/index.d.ts", "import": "./dist/pack/index.js" },
    "./geocode": { "types": "./dist/geocode/index.d.ts", "import": "./dist/geocode/index.js" },
    "./route": { "types": "./dist/route/index.d.ts", "import": "./dist/route/index.js" },
    "./tiles": { "types": "./dist/tiles/index.d.ts", "import": "./dist/tiles/index.js" },
    "./selftest": { "types": "./dist/selftest/index.d.ts", "import": "./dist/selftest/index.js" }
  },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.6"
  }
}
