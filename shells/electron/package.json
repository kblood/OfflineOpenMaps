{
  "name": "@openmaps/electron-shell",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "concurrently \"vite\" \"npm:dev:main\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "dist:portable": "npm run build && node ../../scripts/package-win.mjs && node ../../scripts/smoke-shot.mjs"
  },
  "dependencies": {
    "@openmaps/core": "*",
    "@openmaps/platform-node": "*",
    "@openmaps/region-builder": "*",
    "maplibre-gl": "^4.7.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^42.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "description": "Offline-first mapping app — Electron shell",
  "author": "OpenMaps v2"
}
